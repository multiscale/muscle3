ymmsl_version: v0.2

description: |
  yMMSL metadata for the meso code

programs:
  meso:
    ports:
      f_init: init
      o_i: out
      s: in
      o_f: final
      timeline sub1:
        s: in1
        o_i: out1
    description: |
      # A model with O_I and S ports on several timelines

      It is called by a macro model, and uses its O_I and S ports on two
      timelines.

      ## Ports

      init: Receives a single integer x
      out: Sends x and x + 1 on two consecutive iterations (timeline of meso)
      in: Receives an integer for each message on out (timeline of meso)
      in1: Receives an integer y on each of two iterations (timeline sub1)
      out1: Sends x + y for each y received on in1 (timeline sub1)
      final: Sends the sum of all integers received on in and in1
    executable: python3
    args: "-m meso"
